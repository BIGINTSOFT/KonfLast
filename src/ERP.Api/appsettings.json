  "Production": {
    "RequireOperatorQualification": true,
    "TimeZone": "Europe/Istanbul",
    "BreakLateStartMinutes": 30,
    "SessionAutoCloseEnabled": true,
    "AutoCloseAfterShiftMinutes": 60,
    "MaxSessionHours": 16,
    "SuspiciousEfficiencyPercent": 200,
    "HandoverWarningMinutes": 15,
    "IdlePromptMinutes": 5
  },
  "Purchasing": {
    "NumberPrefix": "SA",
    "NumberDigits": 5
  },
  "Shipping": {
    "NumberPrefix": "SV",
    "NumberDigits": 5
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Tekstil ERP"
  },
  "ExchangeRates": {
    "AutoFetch": true,
    "FetchAfter": "15:45",
    "RetryMinutes": 30,
    "TcmbBaseUrl": "https://www.tcmb.gov.tr/kurlar/",
    "TimeoutSeconds": 20
  },
  "Planning": {
    "WorkingDays": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" ],
    "DefaultEfficiencyPercent": 100
  },
  "Integrations": {
    "DispatchEnabled": true,
    "PollSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 10,
    "RetryBaseSeconds": 30,
    "RetryMaxMinutes": 360,
    "LeaseSeconds": 120,
    "Webhooks": []
  },
  "LiveUpdates": {
    "MinIntervalMilliseconds": 500
  },
  "Rfid": {
    "DebounceSeconds": 3
  },
  "Tablets": {
    "OnlineThresholdSeconds": 90
  },
  "TabletPairing": {
    "Password": "271123"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Enabled": true
  },
  "InitialAdmin": {
    "UserName": "",
    "Password": "",
    "FullName": "Sistem Yöneticisi"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/erp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {UserId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
