  "ProductionOrders": {
    "NumberPrefix": "IE",
    "NumberDigits": 5
  },
  "Bundles": {
    "NumberDigits": 6,
    "MaxBundleSize": 1000,
    "MaxBundlesPerRequest": 1000,
    "OverageTolerancePercent": 0
